# Desmos API Key (Use your Desmos API Key or the public demo key below)
VITE_DESMOS_API_KEY=dff6ea11e7df4482bab9a540c52a64a0

# Private Personal Access Passcode (defaults to 2016)
VITE_APP_PASSCODE=2016

# Optional: Google OAuth 2.0 Client ID for Google Identity Services
# Create at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Email Delivery Configuration (for sending live login & welcome emails)
# For Gmail: Use smtp.gmail.com with a 16-character App Password (from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=satifysatceo@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=satifysatceo@gmail.com
